# -----------------------------
# Python / build artifacts
# -----------------------------
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# -----------------------------
# Virtual environment
# -----------------------------
.venv/

# -----------------------------
# Jupyter / Papermill
# -----------------------------
.ipynb_checkpoints/
out/

# -----------------------------
# Local configuration & secrets
# -----------------------------
.env
.env.*
!.env.example
.secrets/
# Service-account keys and other JSON credentials, wherever they are saved.
# Re-include specific JSON files that belong in the repo with a ! rule below.
*.json
!scripts/appsscript.json
!.clasp.json
!tests/fixtures/**/*.json

# -----------------------------
# Local data (real betting data)
# -----------------------------
data/Betfair_Master.csv
data/Archive/
data/BettingPandL*.csv
# Master written here first, then swapped in once verified
*.tmp
*.xlsx
*.xlsm
*.xls
*.parquet
*.zip

# -----------------------------
# OS / editor noise
# -----------------------------
.DS_Store
Thumbs.db
.vscode/

# -----------------------------
# Allow explicitly versioned samples (if ever added)
# -----------------------------
!samples/
!samples/*.csv

requirements.lock.txt
