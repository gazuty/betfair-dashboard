# Betfair Dashboard Environment Configuration
# =============================================
# Copy this file to .env and update with your values.
# These override the defaults in the notebook's Parameters cell.

# --- File Paths ---
# Folder containing BettingPandL*.csv files and Archive/
BASE_FOLDER=data

# Master CSV location (consolidated bet history)
MASTER_CSV=data/Betfair_Master.csv

# Service account JSON path (for Google Sheets API)
GOOGLE_SERVICE_ACCOUNT_JSON=.secrets/google_service_account.json

# --- Google Sheets ---
# Name of the target Google Sheet
GOOGLE_SHEET_NAME=Betfair Dashboard

# --- Analysis Settings (optional) ---
# Uncomment and modify to override notebook defaults

# Start date for rolling return calculations (YYYY-MM-DD)
# ROLLING_START_DATE=2025-03-01

# Weekly aggregation start day (pandas resample format)
# WEEK_START_DAY=W-SUN

# Number of top/bottom tracks in summaries
# TOP_N_TRACKS=15

# Number of top/bottom strike rates in summaries
# TOP_N_STRIKE_RATES=10
